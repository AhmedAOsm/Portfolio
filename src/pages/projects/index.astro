---
import Base from '../../layouts/Base.astro';
import WorkCard from '../../components/WorkCard.astro';
import { getProjects } from '../../lib/works';

const projects = await getProjects();
---

<Base title="Projects" description="Selected architectural projects by Ahmed Ayman.">
  <div class="mx-auto w-full max-w-7xl px-6 pb-8 lg:px-margin">
    <header class="mb-16 border-b border-outline-variant pb-8">
      <div class="flex flex-col items-start justify-between gap-6 md:flex-row md:items-end">
        <div>
          <p class="label-sm text-secondary">Architectural portfolio</p>
          <h1 class="mt-2 font-headline text-[40px] leading-none font-light tracking-[-0.02em] text-primary md:text-[56px] md:leading-[64px]">
            Selected works
          </h1>
        </div>
        <p class="max-w-md text-base leading-[26px] text-on-surface-variant">
          Residential, commercial, and mixed-use projects in Saudi Arabia and Sudan.
        </p>
      </div>
    </header>
    <div class="flex flex-col gap-16">
      {
        projects.map((work, index) => (
          <WorkCard
            href={work.href}
            title={work.entry.data.title}
            location={work.entry.data.location}
            area={work.entry.data.area}
            date={work.entry.data.date}
            summary={work.entry.data.summary}
            category={work.entry.data.category}
            indexLabel={`Project ${String(index + 1).padStart(2, '0')}`}
            image={work.images.hero}
            layout="row"
            reverse={index % 2 === 1}
          />
        ))
      }
    </div>
  </div>
</Base>
