---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
import { withBase } from '../lib/base';
import { getChronology } from '../lib/works';

const works = await getChronology();

const principles = [
  {
    index: '01 / Place',
    title: 'Timeless solutions',
    text: 'Rather than pursuing style as an end in itself, I seek timeless solutions that respond to place, support human activity, and reveal the potential of each project.',
  },
  {
    index: '02 / Light and material',
    title: 'Clear in purpose',
    text: 'Guided by context, light, material, and human experience, I create spaces that are clear in purpose and rich in character.',
  },
  {
    index: '03 / Process',
    title: 'Concept to visualization',
    text: 'My process moves seamlessly from concept development to visualization, transforming ideas into compelling architectural narratives.',
  },
];
---

<Base title="About" description={site.heroLine}>
  <div class="mx-auto w-full max-w-7xl px-6 pb-8 lg:px-margin">
    <section class="grid items-end gap-gutter py-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="label-md text-secondary">Architectural practice</p>
        <h1 class="mt-4 font-headline text-[28px] leading-9 font-light tracking-[-0.01em] text-primary md:text-[56px] md:leading-[64px] md:tracking-[-0.02em]">
          I design architecture that balances vision and reality.
        </h1>
      </div>
    </section>

    <div class="my-12 h-px bg-outline-variant"></div>

    <section class="max-w-3xl">
      <p class="text-base leading-[26px] text-on-surface-variant">{site.manifesto}</p>
    </section>

    <div class="my-16 h-px bg-outline-variant"></div>

    <section class="grid gap-gutter md:grid-cols-3" aria-label="Principles">
      {
        principles.map((item) => (
          <article class="flex flex-col justify-between border border-outline bg-surface p-8">
            <div>
              <p class="label-md text-secondary">{item.index}</p>
              <h2 class="mt-4 font-headline text-2xl leading-8 text-primary">{item.title}</h2>
              <p class="mt-3 text-sm leading-[22px] text-on-surface-variant">{item.text}</p>
            </div>
          </article>
        ))
      }
    </section>

    <div class="my-16 h-px bg-outline-variant"></div>

    <section aria-labelledby="chronology-heading">
      <div class="mb-10 flex flex-col items-start justify-between gap-4 md:flex-row md:items-end">
        <div>
          <p class="label-md text-secondary">Chronology</p>
          <h2 id="chronology-heading" class="mt-2 font-headline text-[28px] leading-9 font-light text-primary md:text-4xl md:leading-[44px]">
            Selected works
          </h2>
        </div>
        <p class="max-w-md text-sm leading-[22px] text-on-surface-variant">
          Projects and gallery studies in the order they were dated, from 2015 to 2026.
        </p>
      </div>
      <ol class="border-t border-outline-variant">
        {
          works.map((work) => (
            <li class="border-b border-outline-variant">
              <a href={work.href} class="grid gap-2 py-5 transition-none hover:bg-surface-container-low md:grid-cols-12 md:items-baseline md:gap-6 md:px-2">
                <span class="label-md text-secondary md:col-span-2">{work.entry.data.date}</span>
                <span class="font-headline text-lg leading-6 text-primary md:col-span-6">{work.entry.data.title}</span>
                <span class="text-sm leading-[22px] text-on-surface-variant md:col-span-4">{work.entry.data.location}</span>
              </a>
            </li>
          ))
        }
      </ol>
    </section>

    <div class="my-16 h-px bg-outline-variant"></div>

    <section class="grid items-center gap-gutter md:grid-cols-2">
      <div>
        <p class="label-md text-secondary">Contact</p>
        <h2 class="mt-3 font-headline text-[28px] leading-9 font-light text-primary md:text-4xl md:leading-[44px]">
          Every design is an exploration of how architecture can inspire, connect, and endure.
        </h2>
      </div>
      <div>
        <a
          href={withBase('/contact')}
          class="inline-block border border-primary bg-primary px-8 py-4 label-md text-on-primary transition-none hover:bg-transparent hover:text-primary"
        >
          Get in touch
        </a>
      </div>
    </section>
  </div>
</Base>
