---
import { nav, site } from '../data/site';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname === href || pathname.startsWith(`${href}/`);
}
---

<header class="fixed top-0 left-0 z-50 w-full border-b border-outline-variant bg-surface">
  <div class="mx-auto flex w-full max-w-7xl items-center justify-between px-6 py-4 lg:px-margin">
    <a href="/" class="font-headline text-lg font-light tracking-[0.14em] text-primary uppercase">
      {site.name}
    </a>
    <nav class="hidden items-center gap-8 md:flex" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'font-headline text-lg leading-6 text-on-surface-variant transition-none hover:text-primary',
              isActive(item.href) && 'border-b border-primary pb-1 font-medium text-primary',
            ]}
            aria-current={isActive(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <button
      type="button"
      class="font-headline text-sm tracking-[0.08em] text-primary uppercase md:hidden"
      aria-expanded="false"
      aria-controls="mobile-nav"
      data-menu-button
    >
      Menu
    </button>
  </div>
  <nav
    id="mobile-nav"
    class="hidden border-t border-outline-variant bg-surface md:hidden"
    aria-label="Mobile"
    data-menu-panel
  >
    <ul class="mx-auto flex max-w-7xl flex-col px-6 py-2">
      {
        nav.map((item) => (
          <li class="border-b border-outline-variant last:border-b-0">
            <a
              href={item.href}
              class:list={[
                'block py-4 font-headline text-lg text-on-surface-variant',
                isActive(item.href) && 'text-primary',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('[data-menu-button]');
  const panel = document.querySelector<HTMLElement>('[data-menu-panel]');

  button?.addEventListener('click', () => {
    if (!panel || !button) return;
    const hidden = panel.classList.toggle('hidden');
    button.setAttribute('aria-expanded', String(!hidden));
    button.textContent = hidden ? 'Menu' : 'Close';
  });
</script>
