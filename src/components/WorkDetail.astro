---
import { render } from 'astro:content';
import type { Work } from '../lib/works';
import Plate from './Plate.astro';
import WorkImage from './WorkImage.astro';

interface Props {
  work: Work;
  previous?: Work;
  next?: Work;
  indexLabel: string;
}

const { work, previous, next, indexLabel } = Astro.props;
const { Content } = await render(work.entry);
const { title, location, area, date, category } = work.entry.data;
const { hero, photos, drawings } = work.images;
---

<article class="mx-auto w-full max-w-7xl px-6 pb-8 lg:px-margin">
  <header class="border-b border-outline-variant pb-8">
    <p class="label-md text-secondary">{indexLabel} / {category}</p>
    <h1 class="mt-3 max-w-4xl font-headline text-[28px] leading-9 font-light tracking-[-0.01em] text-primary md:text-[56px] md:leading-[64px] md:tracking-[-0.02em]">
      {title}
    </h1>
    <dl class="mt-8 grid gap-6 border-t border-outline-variant pt-6 sm:grid-cols-3">
      <div>
        <dt class="label-sm text-secondary">Location</dt>
        <dd class="mt-1 text-base leading-[26px]">{location}</dd>
      </div>
      <div>
        <dt class="label-sm text-secondary">Area</dt>
        <dd class="mt-1 text-base leading-[26px]">{area}</dd>
      </div>
      <div>
        <dt class="label-sm text-secondary">Date</dt>
        <dd class="mt-1 text-base leading-[26px]">{date}</dd>
      </div>
    </dl>
  </header>

  <figure class="mt-8 border border-outline-variant bg-surface-container-lowest">
    {
      hero ? (
        <WorkImage image={hero} fit="natural" sizes="(min-width: 1280px) 1152px, 100vw" priority />
      ) : (
        <Plate index={indexLabel} title={title} location={location} area={area} />
      )
    }
  </figure>

  <div class="prose-work mt-12 max-w-3xl text-base leading-[26px] text-on-surface">
    <Content />
  </div>

  {
    photos.length > 0 && (
      <section class="mt-16">
        <h2 class="label-md text-secondary">Images</h2>
        <div class="mt-6 flex flex-col gap-6">
          {photos.map((photo) => (
            <figure class="border border-outline-variant bg-surface-container-lowest">
              <WorkImage image={photo} fit="natural" sizes="(min-width: 1280px) 1152px, 100vw" />
            </figure>
          ))}
        </div>
      </section>
    )
  }

  {
    drawings.length > 0 && (
      <section class="mt-16">
        <h2 class="label-md text-secondary">Plans and sections</h2>
        <div class="mt-6 flex flex-col gap-6">
          {drawings.map((drawing) => (
            <figure class="border border-outline-variant bg-white p-4 md:p-8">
              <WorkImage image={drawing} fit="natural" sizes="(min-width: 1280px) 1152px, 100vw" />
            </figure>
          ))}
        </div>
      </section>
    )
  }

  <nav class="mt-16 grid gap-4 border-t border-outline-variant pt-8 sm:grid-cols-2" aria-label="More work">
    {
      previous ? (
        <a href={previous.href} class="border border-outline-variant p-6 transition-none hover:border-primary">
          <span class="label-sm text-secondary">Previous</span>
          <span class="mt-2 block font-headline text-lg leading-6 text-primary">{previous.entry.data.title}</span>
        </a>
      ) : (
        <span></span>
      )
    }
    {
      next && (
        <a href={next.href} class="border border-outline-variant p-6 text-right transition-none hover:border-primary">
          <span class="label-sm text-secondary">Next</span>
          <span class="mt-2 block font-headline text-lg leading-6 text-primary">{next.entry.data.title}</span>
        </a>
      )
    }
  </nav>
</article>
