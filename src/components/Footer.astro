---
import { nav, site } from '../data/site';
import { withBase } from '../lib/base';

const year = new Date().getFullYear();
---

<footer class="mt-20 border-t border-outline-variant">
  <div class="mx-auto flex w-full max-w-7xl flex-col gap-8 px-6 py-margin lg:px-margin md:flex-row md:items-start md:justify-between">
    <div>
      <a href={withBase('/')} class="font-headline text-lg font-light tracking-[0.14em] text-primary uppercase">
        {site.name}
      </a>
      <p class="mt-3 text-sm leading-[22px] text-secondary">{site.role}</p>
    </div>
    <nav class="flex flex-wrap gap-x-6 gap-y-3" aria-label="Footer">
      {
        nav.map((item) => (
          <a href={withBase(item.href)} class="label-sm text-on-surface-variant transition-none hover:text-primary">
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="flex flex-col gap-2 text-sm leading-[22px]">
      <a href={`mailto:${site.email}`} class="text-primary transition-none hover:underline">{site.email}</a>
      <a href={`tel:${site.phone}`} class="text-primary transition-none hover:underline">{site.phoneDisplay}</a>
      <a href={site.whatsapp} class="text-primary transition-none hover:underline">WhatsApp</a>
    </div>
  </div>
  <div class="mx-auto w-full max-w-7xl px-6 pb-8 lg:px-margin">
    <p class="label-sm text-on-surface-variant">© {year} {site.name}. All rights reserved.</p>
  </div>
</footer>
