---
interface Props {
  index: string;
  title: string;
  location: string;
  area: string;
}

const { index, title, location, area } = Astro.props;
---

<div class="flex h-full min-h-64 flex-col justify-between border border-primary bg-surface-container-lowest p-6">
  <span class="label-md text-secondary">{index}</span>
  <div>
    <p class="font-headline text-2xl font-light leading-8 text-primary">{title}</p>
    <p class="mt-3 text-sm leading-[22px] text-secondary">{location}</p>
    <p class="text-sm leading-[22px] text-secondary">{area}</p>
  </div>
</div>
